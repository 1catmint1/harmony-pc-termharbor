{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "-DTT_OHOS_BUILD_NAPI=ON -DTT_OHOS_BUILD_HOST_TESTS=OFF -DTT_OHOS_ENABLE_LIBSSH2=ON",
      "abiFilters": [
        "arm64-v8a"
      ]
    }
  },
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS"
    }
  ]
}
